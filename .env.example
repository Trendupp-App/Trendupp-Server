# Application Setup
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=trendupp_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Logtail / Betterstack Configuration
BETTERSTACK_SOURCE_TOKEN=

# AWS Configuration (S3 & SES)
AWS_S3_REGION=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET=
AWS_SES_REGION=
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_FROM_EMAIL=

# Email sender identity (must be a verified address/domain on SES).
EMAIL_FROM=noreply@trendupp.com
EMAIL_FROM_NAME=Trendupp

# Security Config
ALLOWED_ORIGINS=*
JWT_SECRET=trendupp-default-secret-key-for-development-and-testing
JWT_EXPIRES_IN=24h
ONBOARDING_API_KEY=trendupp-default-onboarding-api-key-for-development-and-testing

# Google Social Auth
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# TikTok Social Auth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Social Auth
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Facebook OAuth (login + social connect) — Meta app with "Facebook Login" product
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Sign in with Apple — comma-separated token audiences (iOS bundle id, web Services ID)
APPLE_CLIENT_IDS=

# Firebase Cloud Messaging (push) — base64 of the service-account JSON:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# YouTube OAuth (social connect — follower/subscriber verification)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Twitter / X OAuth (social connect — follower verification; requires paid API tier)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Stream Chat
STREAM_API_KEY=
STREAM_API_SECRET=

# Payment Gateway (PandasCrow Checkout Redirect)
PAYMENT_CALLBACK_URL=


# Log every SQL query to the console (very noisy — debugging only)
DB_LOGGING=false
